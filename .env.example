# ============================================================
# Nifty 50 Iron Condor Strategy — Configuration Template
# Copy to .env and adjust values as needed.
#
# NOTE: This template intentionally mirrors the live .env values
# used in the walkforward pipeline. config.py holds Pydantic
# BaseSettings with safer range defaults; the .env overrides
# those for the live deployment. When updating live values,
# also update this file so the two stay in sync.
# ============================================================

# ── Capital-aware strike selection (module12) ──
IC_CAPITAL_INR=500000
IC_CAPITAL_AT_RISK_PCT=0.20
IC_TARGET_RETURN_MONTHLY_PCT=0.025
IC_TARGET_RETURN_WEEKLY_PCT=0.008
IC_EXPIRY_MODE=weekly
IC_MAX_EXTRA_BUFFER_PTS=500
IC_MIN_POP=0.70
IC_MAX_BREACH_PROB_PER_LEG=0.15

# ── Spread filtering & output (module9) ──
MIN_DTE_TO_TRADE=7
MIN_RR_RATIO=0.20
MIN_EV_PROXY_PTS=0.0
MIN_PREMIUM_PTS=18
MIN_PREMIUM_LOW_VIX_PTS=10
MIN_PREMIUM_MID_VIX_PTS=15
MIN_PREMIUM_HIGH_VIX_PTS=20
MAX_SPREADS_OUTPUT=6
MIN_OI_LIQUIDITY=500

# ── Iron condor wing widths ──
WING_WIDTH_LOW_VIX=300
WING_WIDTH_MID_VIX=450
WING_WIDTH_HIGH_VIX=500

# ── Credit spread wing widths (tighter than IC for higher ROC) ──
SPREAD_WING_WIDTH_LOW_VIX=100
SPREAD_WING_WIDTH_MID_VIX=150
SPREAD_WING_WIDTH_HIGH_VIX=200

# ── Buffer (walk-forward uses 100 for safety margin) ──
STRIKE_BUFFER_POINTS=100
MIN_BUFFER_POINTS=100
SPREAD_BUFFER_POINTS=50

# ── PCR Skew ──
PCR_BEAR_THRESHOLD=0.80
PCR_BULL_THRESHOLD=1.20
PCR_PUT_TIGHTEN_PTS=30
PCR_CALL_TIGHTEN_PTS=30

# ── Quantile Alphas — P10/P90 balances coverage vs premium ──
ALPHA_LOW_P10=0.10
ALPHA_LOW_P90=0.90
ALPHA_MID_P10=0.10
ALPHA_MID_P90=0.90
ALPHA_HIGH_P10=0.10
ALPHA_HIGH_P90=0.90
REGIME_RECENT_ONLY_YEARS=2.0

# ── Costs ──
NIFTY_LOT_SIZE=65
BROKERAGE_PER_TRADE_INR=20.0
RISK_FREE_RATE=0.065
DIVIDEND_YIELD=0.015

# ── Direction / Skew ──
DIRECTION_CONFIDENCE_THRESHOLD=0.35
WEIGHT_ROC=0.45
WEIGHT_VIX=0.35
WEIGHT_GARCH=0.20
CALL_SKEW_FACTOR=0.01

# ── Walk-Forward Backtest (module7b) ──
WF_INITIAL_TRAIN_WEEKS=120
WF_RETRAIN_EVERY_WEEKS=4
WF_CALIBRATION_WEEKS=60
WF_SL_MULTIPLIER=3.0
WF_SLIPPAGE_ENTRY=1.0
WF_SLIPPAGE_EXIT=0.5
WF_MIN_PREMIUM_PTS=20
WF_MIN_COST_COVER_MULT=3.0
WF_MAX_VIX_TRADE=22
WF_SOFT_VIX_LOWER=15.0
WF_SOFT_SIZE_MULT=0.75

# ── Model Drift Monitor (module13) ──
MONITOR_COVERAGE_DECAY=0.05
MONITOR_DRIFT_WINDOW_WEEKS=12
MONITOR_FEATURE_DRIFT_PVAL=0.01

# ── Target coverage for conformal calibration ──
TARGET_COVERAGE=0.85
